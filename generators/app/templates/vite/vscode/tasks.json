{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "npm: dev",
      "command": "npm run dev -- --host 127.0.0.1",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*"
        }
      }
    }
  ]
}
