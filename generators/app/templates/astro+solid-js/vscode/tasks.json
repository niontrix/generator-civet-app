{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "astro: dev",
			"type": "shell",
			"command": "npm run dev -- --host 127.0.0.1",
			"isBackground": true,
			"problemMatcher": {
				"owner": "astro",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "npm run dev|astro dev",
					"endsPattern": "Local\\s+(https?://\\S+)"
				}
			}
		}
	]
}
