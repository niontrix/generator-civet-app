{
  "name": "generator-civet-app",
  "version": "0.1.0",
  "type": "module",
  "description": "A Yeoman generator to scaffold projects for the Civet language (https://civet.dev).",
  "homepage": "github.com/niontrix/generator-civet-app",
  "author": {
    "name": "Tobias Heinlein",
    "email": "dev_th@mailbox.org",
    "url": ""
  },
  "files": [
    "generators"
  ],
  "main": "generators/index.js",
  "keywords": [
    "yo",
    "yeoman",
    "generator",
    "civet",
    "yeoman-generator"
  ],
  "engines": {
    "node": ">= 22.0.0"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "yeoman-generator": "^8.2.2",
    "yosay": "^3.0.0"
  },
  "devDependencies": {
    "@yeoman/adapter": "^4.0.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "vitest": "^4.1.10",
    "xo": "^4.0.0",
    "yeoman-environment": "^6.1.0",
    "yeoman-test": "^11.6.0"
  },
  "lint-staged": {
    "*.js": [
      "xo --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "scripts": {
    "lint": "xo",
    "pretest": "npm run lint",
    "test": "xo && vitest run",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niontrix/generator-civet-app.git"
  },
  "license": "LGPL-3.0"
}
